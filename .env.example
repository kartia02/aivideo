# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your keys.  Never commit `.env`.
# ---------------------------------------------------------------------------

# --- App ---
DEBUG=false
# JSON list; use your frontend origin in production, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["*"]
HTTP_TIMEOUT_SECONDS=60

# Finished clips are saved here as <task_id>.mp4 next to a <task_id>.json
# record, which is also how tasks survive a restart. The provider deletes the
# original after 2 days, so this directory is the only lasting copy.
OUTPUT_DIR=outputs
# Only used to print an approximate KRW figure beside the USD estimate.
USD_KRW_RATE=1400

# --- Prompt enhancer -------------------------------------------------------
# Which LLM writes the cinematic prompt: "openai" or "gemini".
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=openai — https://platform.openai.com/api-keys
# Left blank on purpose: a placeholder value makes /api/health report the
# provider as configured and the failure only shows up at the first call.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required when LLM_PROVIDER=gemini — https://aistudio.google.com/app/apikey
# The same key also drives Veo when VIDEO_PROVIDER=gemini (see below).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

LLM_TEMPERATURE=0.9
LLM_MAX_OUTPUT_TOKENS=600

# --- Video generation ------------------------------------------------------
# "gemini" runs Veo on GEMINI_API_KEY above — one key for the whole app.
# "replicate" uses REPLICATE_API_TOKEN instead.
VIDEO_PROVIDER=gemini

# --- ...when VIDEO_PROVIDER=gemini (Veo) ---
# Veo requires a BILLED Google Cloud project; the free tier cannot generate
# video and returns 429 / "quota exceeded".
# veo-3.1-lite-generate-preview   $0.05/s 720p, $0.08/s 1080p  (cheapest)
# veo-3.1-fast-generate-preview   $0.10/s 720p, $0.12/s 1080p
# veo-3.1-generate-preview        $0.40/s 720-1080p, $0.60/s 4k
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_RESOLUTION=720p

# --- ...when VIDEO_PROVIDER=replicate ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# "owner/name" runs the model's current version (official models),
# "owner/name:<version_id>" pins an exact version.
REPLICATE_MODEL=minimax/video-01
